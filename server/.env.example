# Copy to .env (scripts/detect_hardware.py writes one for you).

# Name shown on the tablet
CG_SERVER_NAME=چشم‌گویا
CG_PORT=8765
# Address to put in the pairing QR code; leave empty for the detected LAN IP,
# or set your Tailscale IP (100.x.y.z) to use the server from outside the home.
CG_PUBLIC_HOST=

# Models (chosen by detect_hardware.py according to VRAM)
CG_LLM_MODEL=qwen3.5:9b
CG_RANKER_MODEL=Qwen/Qwen3-1.7B
CG_WHISPER_MODEL=large-v3-turbo
CG_WHISPER_COMPUTE_TYPE=float16
CG_DEFAULT_VOICE=fa_IR-amir-medium

# Load models at start-up instead of on first use
CG_LAZY_MODELS=false

# Privacy
CG_LOG_MESSAGE_TEXT=false
CG_LAN_ONLY=true
CG_MDNS=true
